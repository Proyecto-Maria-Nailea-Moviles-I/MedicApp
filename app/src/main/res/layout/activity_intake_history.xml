<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    tools:context=".IntakeHistoryActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_History"
        android:layout_width="0dp"
        android:layout_height="85dp"
        android:background="@color/home_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack_History"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/medication_back"
            app:srcCompat="@drawable/icon_back"
            app:tint="@android:color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvTitle_History"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/history_title"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/btnBack_History"
            app:layout_constraintEnd_toStartOf="@+id/btnCalendar_History"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/btnCalendar_History"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/history_calendar"
            app:srcCompat="@android:drawable/ic_menu_my_calendar"
            app:tint="@android:color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scrollHistory"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/header_History"
        app:layout_constraintBottom_toTopOf="@+id/tableNavigation_History"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TableLayout
            android:id="@+id/tableHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:stretchColumns="0">

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvHistoryLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/history_title"
                    android:textColor="@color/home_gray"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvSelectedDate_History"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:padding="16dp"
                    android:text="@string/history_all_dates"
                    android:textColor="@color/home_gray"
                    android:textSize="16sp" />

            </TableRow>

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvEmpty_History"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@android:color/white"
                    android:minHeight="160dp"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="@string/history_empty"
                    android:textColor="@color/home_gray"
                    android:textSize="16sp" />

            </TableRow>

        </TableLayout>

    </ScrollView>

    <TableLayout
        android:id="@+id/tableNavigation_History"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnHome_History"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="70dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/home_nav_home"
                android:textAllCaps="false"
                android:textSize="10sp"
                android:textColor="@color/home_blue"
                android:backgroundTint="@android:color/white"
                android:drawableTop="@drawable/icon_home"
                android:drawableTint="@color/home_blue"
                android:drawablePadding="4dp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnMedicationList_History"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="70dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/home_nav_medications"
                android:textAllCaps="false"
                android:textSize="10sp"
                android:textColor="@color/home_blue"
                android:backgroundTint="@android:color/white"
                android:drawableTop="@drawable/icon_medication"
                android:drawableTint="@color/home_blue"
                android:drawablePadding="4dp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnPharmacy_History"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="70dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/home_nav_map"
                android:textAllCaps="false"
                android:textSize="10sp"
                android:textColor="@color/home_blue"
                android:backgroundTint="@android:color/white"
                android:drawableTop="@drawable/icon_map"
                android:drawableTint="@color/home_blue"
                android:drawablePadding="4dp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnHistory_History"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="70dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/home_nav_history"
                android:textAllCaps="false"
                android:textSize="10sp"
                android:textColor="@color/home_blue"
                android:backgroundTint="@android:color/white"
                android:drawableTop="@drawable/icon_history"
                android:drawableTint="@color/home_blue"
                android:drawablePadding="4dp"
                android:gravity="center" />

        </TableRow>

    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
