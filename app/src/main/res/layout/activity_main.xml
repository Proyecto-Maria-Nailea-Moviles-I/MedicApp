<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_Main"
        android:layout_width="0dp"
        android:layout_height="125dp"
        android:background="@color/home_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvWelcome_Main"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="35dp"
            android:text="@string/home_greeting"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnProfile_Main"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSubtitle_Main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:text="@string/home_subtitle"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvWelcome_Main" />

        <ImageButton
            android:id="@+id/btnProfile_Main"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="35dp"
            android:layout_marginEnd="18dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/home_profile"
            app:srcCompat="@drawable/icon_user"
            app:tint="@android:color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvNextDose_Main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="22dp"
        android:text="@string/home_next_dose"
        android:textColor="@color/home_gray"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_Main" />

    <TableLayout
        android:id="@+id/tableNextDose_Main"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="12dp"
        android:background="@android:color/white"
        android:padding="20dp"
        android:elevation="3dp"
        app:layout_constraintTop_toBottomOf="@+id/tvNextDose_Main"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvNoDose_Main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="@string/home_no_next_dose"
                android:textColor="@color/home_gray"
                android:textSize="15sp" />

        </TableRow>

    </TableLayout>

    <TextView
        android:id="@+id/tvMyMedications_Main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="25dp"
        android:text="@string/home_my_medications"
        android:textColor="@color/home_gray"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tableNextDose_Main" />

    <TableLayout
        android:id="@+id/tableMedications_Main"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="12dp"
        android:background="@android:color/white"
        android:padding="16dp"
        android:elevation="3dp"
        app:layout_constraintTop_toBottomOf="@+id/tvMyMedications_Main"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvNoMedications_Main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="@string/home_no_medications"
                android:textColor="@color/home_gray"
                android:textSize="15sp" />

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnMedication_Main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_add_medication"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/home_blue" />

        </TableRow>

    </TableLayout>

    <TableLayout
        android:id="@+id/tableNavigation_Main"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:elevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnHome_Main"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="70dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/home_nav_home"
                android:textAllCaps="false"
                android:textSize="10sp"
                android:textColor="@color/home_blue"
                android:backgroundTint="@android:color/white"
                android:drawableTop="@drawable/icon_home"
                android:drawableTint="@color/home_blue"
                android:drawablePadding="4dp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnMedicationList_Main"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="70dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/home_nav_medications"
                android:textAllCaps="false"
                android:textSize="10sp"
                android:textColor="@color/home_blue"
                android:backgroundTint="@android:color/white"
                android:drawableTop="@drawable/icon_medication"
                android:drawableTint="@color/home_blue"
                android:drawablePadding="4dp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnPharmacy_Main"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="70dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/home_nav_map"
                android:textAllCaps="false"
                android:textSize="10sp"
                android:textColor="@color/home_blue"
                android:backgroundTint="@android:color/white"
                android:drawableTop="@drawable/icon_map"
                android:drawableTint="@color/home_blue"
                android:drawablePadding="4dp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnHistory_Main"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="70dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/home_nav_history"
                android:textAllCaps="false"
                android:textSize="10sp"
                android:textColor="@color/home_blue"
                android:backgroundTint="@android:color/white"
                android:drawableTop="@drawable/icon_history"
                android:drawableTint="@color/home_blue"
                android:drawablePadding="4dp"
                android:gravity="center" />

        </TableRow>

    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
