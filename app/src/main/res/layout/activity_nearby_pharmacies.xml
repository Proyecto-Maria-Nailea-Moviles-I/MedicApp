<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background"
    tools:context=".NearbyPharmaciesActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_Pharmacy"
        android:layout_width="0dp"
        android:layout_height="85dp"
        android:background="@color/home_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack_Pharmacy"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/medication_back"
            app:srcCompat="@drawable/icon_back"
            app:tint="@android:color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvTitle_Pharmacy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/pharmacies_title"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/btnBack_Pharmacy"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TableLayout
        android:id="@+id/tablePharmacy"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@android:color/white"
        android:padding="16dp"
        android:stretchColumns="1"
        app:layout_constraintTop_toBottomOf="@+id/header_Pharmacy"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/txtSearch_Pharmacy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/pharmacy_search_hint"
                android:inputType="text" />

            <ImageButton
                android:id="@+id/btnSearch_Pharmacy"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/pharmacy_search_description"
                app:srcCompat="@android:drawable/ic_menu_search" />

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvEmpty_Pharmacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_span="2"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="@string/pharmacy_empty"
                android:textColor="@color/home_gray"
                android:textSize="15sp" />

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="135dp"
                android:layout_height="wrap_content"
                android:text="@string/lblPharmacyName" />

            <TextView
                android:id="@+id/tvName_Pharmacy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="40dp" />

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="135dp"
                android:layout_height="wrap_content"
                android:text="@string/lblPharmacyAddress" />

            <TextView
                android:id="@+id/tvAddress_Pharmacy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="40dp" />

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="135dp"
                android:layout_height="wrap_content"
                android:text="@string/lblPharmacyPhone" />

            <TextView
                android:id="@+id/tvPhone_Pharmacy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="40dp" />

        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnDirections_Pharmacy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="20dp"
                android:text="@string/pharmacy_directions"
                android:textAllCaps="false"
                android:backgroundTint="@color/home_blue" />

            <Button
                android:id="@+id/btnDetails_Pharmacy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="20dp"
                android:text="@string/pharmacy_details"
                android:textAllCaps="false"
                android:backgroundTint="@color/home_gray" />

        </TableRow>

    </TableLayout>

    <TableLayout
        android:id="@+id/tableNavigation_Pharmacy"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnHome_Pharmacy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="70dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/home_nav_home"
                android:textAllCaps="false"
                android:textSize="10sp"
                android:textColor="@color/home_blue"
                android:backgroundTint="@android:color/white"
                android:drawableTop="@drawable/icon_home"
                android:drawableTint="@color/home_blue"
                android:drawablePadding="4dp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnMedicationList_Pharmacy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="70dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/home_nav_medications"
                android:textAllCaps="false"
                android:textSize="10sp"
                android:textColor="@color/home_blue"
                android:backgroundTint="@android:color/white"
                android:drawableTop="@drawable/icon_medication"
                android:drawableTint="@color/home_blue"
                android:drawablePadding="4dp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnPharmacy_Pharmacy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="70dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/home_nav_map"
                android:textAllCaps="false"
                android:textSize="10sp"
                android:textColor="@color/home_blue"
                android:backgroundTint="@android:color/white"
                android:drawableTop="@drawable/icon_map"
                android:drawableTint="@color/home_blue"
                android:drawablePadding="4dp"
                android:gravity="center" />

            <Button
                android:id="@+id/btnHistory_Pharmacy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="70dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/home_nav_history"
                android:textAllCaps="false"
                android:textSize="10sp"
                android:textColor="@color/home_blue"
                android:backgroundTint="@android:color/white"
                android:drawableTop="@drawable/icon_history"
                android:drawableTint="@color/home_blue"
                android:drawablePadding="4dp"
                android:gravity="center" />

        </TableRow>

    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
