<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/imgIcon_DialogTake"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/btn_take_medication"
        app:srcCompat="@drawable/icon_check"
        app:tint="#4CAF50" />

    <TextView
        android:id="@+id/tvTitle_DialogTake"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/dialog_take_title"
        android:textColor="@color/home_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSubtitle_DialogTake"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/dialog_take_subtitle"
        android:textColor="@color/home_gray"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnAccept_DialogTake"
        android:layout_width="200dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_button_accept"
        app:backgroundTint="@null"
        android:text="@string/btnAccept"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
